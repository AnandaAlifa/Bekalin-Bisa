# Contoh konfigurasi environment — salin ke .env lalu isi sesuai lokal.
# Jangan pernah mengisi nilai rahasia sungguhan di file ini.

# Backend (TASK-004)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/pintara

# CORS — origin frontend yang diizinkan (TASK-006), dipisah koma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
