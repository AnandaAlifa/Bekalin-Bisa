# Backend (TASK-004)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/pintara

# CORS — origin frontend yang diizinkan (TASK-006), dipisah koma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autentikasi (AUTH-004) — JWT HS256
# SECRET_KEY wajib: minimal 32 byte acak (contoh: `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=CHANGE_ME_random_32_bytes_hex
# Masa berlaku access token (menit), default 60
ACCESS_TOKEN_EXPIRE_MINUTES=60
